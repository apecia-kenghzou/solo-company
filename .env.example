# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings + DALL-E)
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=solo-agent-os
PINECONE_ENVIRONMENT=us-east-1-aws

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soloagent

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage — choose ONE provider block below
# S3_PROVIDER options: aws | r2 | minio | garage
S3_PROVIDER=minio
S3_BUCKET_NAME=solo-agent-files

# ── MinIO (self-hosted, default for docker-compose) ──────────────────────────
S3_ENDPOINT_URL=http://minio:9000       # internal Docker hostname; use http://localhost:9000 outside Docker
S3_PUBLIC_URL_BASE=http://localhost:9000/solo-agent-files  # rewrite to external-facing URL
S3_REGION=us-east-1                    # any string works for MinIO/Garage
AWS_ACCESS_KEY_ID=minioadmin           # set in docker-compose MINIO_ROOT_USER
AWS_SECRET_ACCESS_KEY=minioadmin       # set in docker-compose MINIO_ROOT_PASSWORD
S3_VERIFY_SSL=false                    # false for local MinIO without TLS

# ── Garage (self-hosted, distributed) ────────────────────────────────────────
# S3_PROVIDER=garage
# S3_ENDPOINT_URL=http://garage:3900    # Garage S3 API port
# S3_PUBLIC_URL_BASE=http://localhost:3902/solo-agent-files  # Garage web port
# S3_REGION=garage                      # Garage accepts any region string
# AWS_ACCESS_KEY_ID=<garage-access-key>
# AWS_SECRET_ACCESS_KEY=<garage-secret-key>
# S3_VERIFY_SSL=false

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# S3_PROVIDER=r2
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL_BASE=https://files.yourdomain.com  # R2 custom domain
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=<r2-access-key-id>
# AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
# S3_VERIFY_SSL=true

# ── AWS S3 ───────────────────────────────────────────────────────────────────
# S3_PROVIDER=aws
# S3_ENDPOINT_URL=                      # leave blank for AWS
# S3_PUBLIC_URL_BASE=                   # leave blank — auto-built
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_VERIFY_SSL=true

# Gmail
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# WhatsApp (360dialog)
WHATSAPP_API_KEY=...
WHATSAPP_API_URL=https://waba.360dialog.io/v1

# Meta Graph API
META_ACCESS_TOKEN=...
META_PAGE_ID=...
META_IG_USER_ID=...

# Buffer
BUFFER_ACCESS_TOKEN=...

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=...
GOOGLE_CALENDAR_CLIENT_SECRET=...

# Apify
APIFY_API_TOKEN=...

# Tavily
TAVILY_API_KEY=...

# Ideogram
IDEOGRAM_API_KEY=...

# Stripe
STRIPE_SECRET_KEY=...
STRIPE_WEBHOOK_SECRET=...

# Clerk (Auth)
CLERK_SECRET_KEY=...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=...

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=...
LANGCHAIN_PROJECT=solo-agent-os

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
