# App
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings + DALL-E)
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=...
PINECONE_INDEX_NAME=solo-agent-os
PINECONE_ENVIRONMENT=us-east-1-aws

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soloagent

# Redis
REDIS_URL=redis://localhost:6379/0

# AWS / Cloudflare R2 (file storage)
S3_BUCKET_NAME=solo-agent-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_ENDPOINT_URL=  # leave blank for AWS, set for R2: https://xxx.r2.cloudflarestorage.com

# Gmail
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REDIRECT_URI=http://localhost:8000/api/auth/gmail/callback

# WhatsApp (360dialog)
WHATSAPP_API_KEY=...
WHATSAPP_API_URL=https://waba.360dialog.io/v1

# Meta Graph API
META_ACCESS_TOKEN=...
META_PAGE_ID=...
META_IG_USER_ID=...

# Buffer
BUFFER_ACCESS_TOKEN=...

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=...
GOOGLE_CALENDAR_CLIENT_SECRET=...

# Apify
APIFY_API_TOKEN=...

# Tavily
TAVILY_API_KEY=...

# Ideogram
IDEOGRAM_API_KEY=...

# Stripe
STRIPE_SECRET_KEY=...
STRIPE_WEBHOOK_SECRET=...

# Clerk (Auth)
CLERK_SECRET_KEY=...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=...

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=...
LANGCHAIN_PROJECT=solo-agent-os

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
